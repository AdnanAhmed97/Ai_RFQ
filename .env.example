# ---------------------------------------------------------------------------
# RFx Intelligence — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# Placeholders only. Do not put real secrets in this file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Public base URL of the app (used for absolute links in exports).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign the prototype session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-32-byte-hex-string

# --- Anthropic -------------------------------------------------------------
# Model ID used for all AI loops. Kept in config so it never goes stale in code.
# Must be a model this account can actually reach — an unavailable model returns
# 400/404 on the connection test rather than falling back to something else.
ANTHROPIC_MODEL=claude-sonnet-5

# OPTIONAL. Demo-mode fallback key, used only when the buyer has not supplied
# their own key via the BYOK screen. Leave blank to force BYOK.
# The app is BYOK-first: the buyer's key is held in a server-side, session-scoped
# store and is never persisted or returned to the browser.
ANTHROPIC_API_KEY=

# Enables the "Demo Mode" button on /login. Requires ANTHROPIC_API_KEY above.
# Any value other than "true" disables it.
DEMO_MODE_ENABLED=false

# --- Database --------------------------------------------------------------
# Direct Postgres connection string. All reads, writes, migrations and seeding
# go through this. A Supabase project supplies one under Project Settings >
# Database; a local container works identically.
#   Supabase: postgresql://postgres.<ref>:<password>@<host>:5432/postgres
#   Local:    postgresql://rfx:rfx_dev@localhost:54329/rfx_intelligence
DATABASE_URL=

# --- Supabase Storage ------------------------------------------------------
# Only used for uploaded vendor documents. Not required for the seeded demo,
# which reads fixtures from disk.
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Service-role key. SERVER ONLY. Never expose to the browser, never prefix with
# NEXT_PUBLIC_. All database access in this prototype is server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket that holds uploaded vendor documents.
SUPABASE_STORAGE_BUCKET=vendor-documents

# --- Prototype economics ---------------------------------------------------
# Fixed FX table anchor. Prototype rate, NOT live market data — surfaced as
# such in the UI wherever a converted value is shown.
FX_USD_INR=84.5

# --- Uploads ---------------------------------------------------------------
# Max accepted vendor document size, in megabytes.
MAX_UPLOAD_MB=25
