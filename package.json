{
  "name": "rfx-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/migrate.ts --reset",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:test-setup": "tsx --env-file-if-exists=.env.local scripts/setup-test-db.ts",
    "provision": "tsx --env-file-if-exists=.env.local scripts/provision.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@supabase/supabase-js": "^2.117.0",
    "@tanstack/react-table": "^9.2.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "docx": "^9.7.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
